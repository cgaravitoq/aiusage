{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "aiusage",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "main": "@astrojs/cloudflare/entrypoints/server",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "workers_dev": false,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "aiusage",
      "database_id": "370550fd-da01-41e5-9e36-3c6f3fc8e36a",
      "migrations_dir": "./migrations"
    }
  ],
  "routes": [{ "pattern": "aiusage.cgaravito.dev", "custom_domain": true }]
}
