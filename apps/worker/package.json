{
  "name": "@aiusage/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun run widget:build && astro build",
    "check-types": "astro check && tsc --noEmit -p src/widget",
    "dev": "astro dev",
    "preview": "astro preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "widget:build": "bun build src/widget/index.ts --minify --target=browser --format=iife --outfile public/widget/v1.js"
  },
  "dependencies": {
    "@astrojs/cloudflare": "14.3.3",
    "@astrojs/vue": "7.0.2",
    "astro": "7.3.4",
    "hono": "4.13.13",
    "unstorage": "^1.17.5",
    "vue": "3.5.43",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/node": "^24.13.6",
    "happy-dom": "^20.14.5",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11",
    "wrangler": "^4.147.0"
  }
}
