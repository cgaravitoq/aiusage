---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  :root {
    color-scheme: light dark;
  }

  body {
    margin: 0 auto;
    max-width: 42rem;
    padding: 3rem 1.25rem 5rem;
    font: 16px/1.6 system-ui, -apple-system, "Segoe UI", sans-serif;
    background: Canvas;
    color: CanvasText;
  }

  h1 {
    margin: 0 0 1rem;
    font-size: 1.75rem;
  }

  h2 {
    margin: 0 0 0.25rem;
    font-size: 1rem;
  }

  p {
    margin: 0 0 1rem;
  }

  ol {
    margin: 0;
    padding-left: 1.5rem;
  }

  li {
    margin-bottom: 1.75rem;
  }

  a {
    color: inherit;
    text-underline-offset: 2px;
  }

  code {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.875em;
  }

  pre {
    margin: 0 0 0.5rem;
    padding: 0.75rem 1rem;
    overflow-wrap: anywhere;
    white-space: pre-wrap;
    background: color-mix(in oklab, CanvasText 8%, Canvas);
    border-radius: 0.5rem;
  }

  pre code {
    font-size: 0.8125rem;
  }

  button {
    padding: 0.125rem 0.5rem;
    border: 1px solid color-mix(in oklab, CanvasText 30%, Canvas);
    border-radius: 0.375rem;
    background: Canvas;
    color: CanvasText;
    font: inherit;
    font-size: 0.8125rem;
    cursor: pointer;
  }

  footer {
    margin-top: 3rem;
    font-size: 0.875rem;
  }

  footer a + a {
    margin-left: 1rem;
  }
</style>
