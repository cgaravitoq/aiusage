---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <header class="site-header"><a class="brand" href="/">aiusage</a><span>Token usage, on your site.</span></header>
    <slot />
  </body>
</html>

<style is:global>
  @font-face {
    font-family: "Instagram Sans";
    src: url("/fonts/instagram-sans-regular.woff2") format("woff2");
    font-style: normal;
    font-weight: 400;
    font-display: swap;
  }

  @font-face {
    font-family: "Instagram Sans";
    src: url("/fonts/instagram-sans-medium.woff2") format("woff2");
    font-style: normal;
    font-weight: 500;
    font-display: swap;
  }

  @font-face {
    font-family: "Instagram Sans";
    src: url("/fonts/instagram-sans-bold.woff2") format("woff2");
    font-style: normal;
    font-weight: 700;
    font-display: swap;
  }

  :root {
    color-scheme: light;
    --background: oklch(0.9551 0 0);
    --foreground: oklch(0.3211 0 0);
    --card: oklch(0.9702 0 0);
    --primary: oklch(0.4349 0 0);
    --primary-foreground: oklch(1 0 0);
    --secondary: oklch(0.9067 0 0);
    --muted-foreground: oklch(0.5103 0 0);
    --border: oklch(0.8576 0 0);
    --ring: oklch(0.4349 0 0);
    --font-sans: "Instagram Sans", sans-serif;
    --font-mono: "Fira Code", monospace;
  }

  * { box-sizing: border-box; }

  html { background: var(--background); }

  body {
    min-height: 100vh;
    margin: 0;
    color: var(--foreground);
    background: var(--background);
    font: 16px/1.6 var(--font-sans);
  }

  body::before {
    position: absolute;
    top: 6.5rem;
    left: 0;
    right: 0;
    height: 1px;
    background: repeating-linear-gradient(to right, var(--border) 0 6px, transparent 6px 14px);
    content: "";
  }

  body::after {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 6.5rem;
    background: radial-gradient(var(--border) 0.5px, transparent 0.5px) 0 0 / 6px 6px;
    content: "";
    pointer-events: none;
  }

  .site-header, main, footer {
    width: min(100% - 2rem, 690px);
    margin-inline: auto;
    padding-inline: 1.25rem;
    border-inline: 1px dashed var(--border);
  }

  .site-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 3.75rem;
    margin-top: 6.5rem;
    font-size: 0.875rem;
  }

  .brand { font-weight: 700; text-decoration: none; }
  .site-header span { color: var(--muted-foreground); }

  main { padding-top: 4.5rem; padding-bottom: 3rem; }
  main.not-found { min-height: 35rem; padding-top: 8rem; text-align: center; }

  h1, h2, h3 { line-height: 1.2; letter-spacing: -0.015em; }
  h1 { margin: 0 0 1rem; font-size: clamp(2.25rem, 7vw, 3rem); font-weight: 700; }
  h2 { margin: 0 0 0.5rem; font-size: 1.5rem; font-weight: 700; }
  main > h2 { margin-top: 2.5rem; }
  h3 { font-size: 1.125rem; font-weight: 700; }
  p { margin: 0 0 1rem; }
  main > p:first-of-type { font-size: 1.125rem; }
  main > p:nth-of-type(2), li p { color: var(--muted-foreground); }
  ol { margin: 3rem 0; padding: 0; list-style: none; counter-reset: steps; }
  ol > li {
    position: relative;
    padding: 1.5rem 0 1.5rem 3.5rem;
    border-top: 1px dashed var(--border);
    counter-increment: steps;
  }
  ol > li:last-child { border-bottom: 1px dashed var(--border); }
  ol > li::before {
    position: absolute;
    top: 1.55rem;
    left: 0;
    display: grid;
    width: 2rem;
    height: 2rem;
    place-items: center;
    border: 1px solid var(--border);
    border-radius: 50%;
    color: var(--muted-foreground);
    font-size: 0.875rem;
    content: counter(steps, decimal-leading-zero);
  }
  a { color: inherit; text-underline-offset: 3px; }
  a:hover { color: var(--primary); }
  a:focus-visible, button:focus-visible, summary:focus-visible {
    outline: 2px solid var(--ring);
    outline-offset: 2px;
  }
  code { font-family: var(--font-mono); font-size: 0.875em; }
  pre {
    margin: 1rem 0;
    padding: 1rem;
    overflow-wrap: anywhere;
    white-space: pre-wrap;
    background: var(--secondary);
    border: 1px solid var(--border);
    border-radius: 0.75rem;
  }
  pre code { font-size: 0.8125rem; }
  button, .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 2.25rem;
    padding: 0.375rem 0.875rem;
    border: 1px solid var(--primary);
    border-radius: 0.5rem;
    background: var(--primary);
    color: var(--primary-foreground);
    font: 500 0.875rem/1.3 var(--font-sans);
    text-decoration: none;
    cursor: pointer;
  }
  button:hover, .button:hover { opacity: 0.9; color: var(--primary-foreground); }
  footer {
    padding-top: 1rem;
    padding-bottom: 3rem;
    border-top: 1px dashed var(--border);
    color: var(--muted-foreground);
    font-size: 0.875rem;
  }
  footer a + a { margin-left: 1rem; }

  @media (max-width: 520px) {
    .site-header, main, footer { width: calc(100% - 1.5rem); padding-inline: 1rem; }
    .site-header span { display: none; }
    main { padding-top: 4rem; }
    ol > li { padding-left: 2.75rem; }
  }
</style>
