---
import KeyReveal from "@/components/key-reveal.vue";
import Base from "@/layouts/base.astro";
import { collectorCommands, widgetSnippet } from "@/snippets";

export const prerender = false;

Astro.response.headers.set("Cache-Control", "no-store");

const newKey = Astro.cookies.get("tokenmax_new_key")?.value ?? null;
if (newKey !== null) {
  Astro.cookies.delete("tokenmax_new_key", { path: "/keys" });
}
const login = Astro.cookies.get("tokenmax_new_login")?.value ?? null;
if (login !== null) {
  Astro.cookies.delete("tokenmax_new_login", { path: "/keys" });
}

const origin = Astro.url.origin;
const installCommand = collectorCommands(origin, "<key>")[1];
---

<Base title="API key">
  {
    newKey === null ? (
      <main>
        <p>
          No key to show. Signing in again issues a new key and revokes every
          existing key of your login on every machine; reinstall the collector
          with the new key by running: <code>{installCommand}</code>.
        </p>
        <p>
          <a href="/auth/github">Sign in with GitHub</a>
        </p>
      </main>
    ) : (
      <main>
        <KeyReveal
          apiKey={newKey}
          commands={collectorCommands(origin, newKey)}
          snippet={widgetSnippet(origin, login ?? "<login>")}
          client:load
        />
        <p>
          Signing in again issues a new key and revokes every existing key of
          your login on every machine; reinstall the collector with the new key
          by running: <code>{installCommand}</code>.
        </p>
      </main>
    )
  }
  <footer><a href="/privacy">Privacy</a></footer>
</Base>
