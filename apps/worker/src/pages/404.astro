---
export const prerender = false;

import Base from "@/layouts/base.astro";

Astro.response.status = 404;
---

<Base title="Not found">
    <main class="not-found">
      <h1>Not found</h1>
      <p>There is nothing at this address.</p>
      <p><a class="button" href="/">Home</a></p>
    </main>
</Base>
