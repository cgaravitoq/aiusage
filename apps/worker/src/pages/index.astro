---
import AgentSetup from "@/components/agent-setup.vue";
import Base from "@/layouts/base.astro";
import {
  agentOpenInTargets,
  agentPrompt,
  collectorCommands,
  widgetSnippet,
} from "@/snippets";

export const prerender = false;

const origin = Astro.url.origin;
const demoLogin = "cgaravitoq";
const installCommand = collectorCommands(origin, "<key>")[1];
const prompt = agentPrompt(origin, { key: "<KEY>", login: "<LOGIN>" });
---

<Base title="aiusage">
  <main>
    <h1>aiusage</h1>
    <p>
      Token-usage summaries for your GitHub login, collected on your machines
      and served at a public URL.
    </p>
    <p>
      This page runs the widget for <code>cgaravitoq</code>, so the bar at the
      top of the screen is the live demo, click it to open.
    </p>
    <ol>
      <li>
        <h2><a class="button" href="/auth/github">Sign in with GitHub</a></h2>
        <p>
          Your login and avatar URL come from the GitHub profile, and your
          login becomes the public address of your summary.
        </p>
      </li>
      <li>
        <h2>Copy the key</h2>
        <p>The page after sign-in shows the key once and never again.</p>
      </li>
      <li>
        <h2>Install the collector</h2>
        <pre><code>{collectorCommands(origin, "<key>").join("\n")}</code></pre>
        <p>
          Bun 1.4.0 or newer on macOS or Linux, Windows is not supported. Run
          the command install prints after <code>load:</code> to start
          collecting.
        </p>
      </li>
      <li>
        <h2>Embed the widget</h2>
        <pre><code>{widgetSnippet(origin, "<login>")}</code></pre>
        <p>
          Both lines go in the layout of your site, and <code>login</code> is
          your GitHub login. A strict Content-Security-Policy needs <code>{origin}</code> in <code>script-src</code> and <code>connect-src</code>.
        </p>
      </li>
    </ol>
    <AgentSetup
      prompt={prompt}
      openIn={agentOpenInTargets(prompt)}
      client:load
    />
    <p>
      Each sign-in issues a new API key and revokes every existing key of your
      login on every machine. After signing in again, reinstall the collector
      with the new key by running: <code>{installCommand}</code>.
    </p>
  </main>
  <footer>
    <a href="/privacy">Privacy</a>
    <a href="/api/health">/api/health</a>
  </footer>
  <script is:inline src={`${origin}/widget/v1.js`} defer></script>
  <aiusage-island login={demoLogin}></aiusage-island>
</Base>
